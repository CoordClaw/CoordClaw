{
  "id": "coordclawcenter",
  "name": "CoordClawCenter",
  "version": "19.70.0",
  "description": "19.70.0 - Code quality refactor: register() split, shared patch library extraction, removal of sessions.json dependency, global Map cascading cleanup, health-poll fallback. WebChat Widget SDK + project-switch.",
  "main": "index.ts",
  "entry": "./dist/index.js",
  "skills": ["./skills"],
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "coordclawJsonPath": {
        "type": "string",
        "description": "Path to coordclaw.json config file (used to locate the project root)"
      },
      "cacheTtlMs": {
        "type": "number",
        "description": "Cache TTL in milliseconds, default 60000"
      },
      "channels": {
        "type": "object",
        "properties": {
          "webchat": {
            "type": "object",
            "properties": {
              "css": {
                "type": "object",
                "description": "CSS variable overrides, e.g. {\"--bg\": \"#0f172a\", \"--accent\": \"#6366f1\"}",
                "additionalProperties": { "type": "string" }
              },
              "cssText": {
                "type": "string",
                "description": "Full custom CSS string"
              },
              "title": {
                "type": "string",
                "description": "Chat window title"
              },
              "placeholder": {
                "type": "string",
                "description": "Input placeholder text"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "additionalProperties": true
  }
}
